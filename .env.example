# --- Provider de IA (sem chave => modo mock offline) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=
# AI_PROVIDER=mock

# --- Contexto ---
SYSTEM_PROMPT_FILE=prompts/system-prompt.md
USER_DATA_FILE=data/user.json
HISTORY_MAX_TURNS=10

# --- Autocrítica: post | blocking | off ---
SELF_CRITIQUE_MODE=post
SELF_CRITIQUE_MAX_REVISIONS=1

# --- Resiliência ---
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000

# --- Rate limit ---
RATE_LIMIT_USER_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=30

# --- Diversos ---
MOCK_STREAM_DELAY_MS=25
AUDIT_LOG_FILE=logs/audit.jsonl
DEBUG=false
